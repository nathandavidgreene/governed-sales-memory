{
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0",
        "wrangler": "^4.162.0"
    },
    "name": "governed-sales-memory",
    "private": true,
    "scripts": {
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "docs:api": "node scripts/gen-api-docs.mjs",
        "docs:build": "node scripts/gen-api-docs.mjs && mkdocs build --strict",
        "docs:serve": "node scripts/gen-api-docs.mjs && mkdocs serve",
        "docs:deploy": "npm run docs:build && wrangler deploy -c docs/wrangler.docs.jsonc"
    },
    "type": "module",
    "version": "0.1.0",
    "dependencies": {
        "mongodb": "^7.9.0"
    }
}
