# Copy to .env (or .dev.vars for Workers) and fill in. Never commit real values.
MONGODB_URI=
MONGODB_DB=
# Voyage key for embedding memory text and search queries (see src/voyage.ts).
VOYAGE_API_KEY=
# Local development and tests only: when MONGODB_URI is unset, the app
# fails closed unless this is set to exactly "true", which allows the
# in-memory store instead. Never set it in a deployment.
ALLOW_IN_MEMORY_STORE=
# Optional: API key for the model the chat may use for free-form
# replies. A Worker secret; when unset, the chat answers with its
# scripted replies only.
MODEL_API_KEY=
